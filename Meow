-- 4. ИГРОВАЯ ЛОГИКА И ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
---------------------------------------------------------------------

local function IsKiller(player)
    if not player then return false end
    if player.Team then
        local tName = player.Team.Name:lower()
        if tName:find("killer") or tName:find("monster") or tName:find("beast") or tName:find("slasher") then
            return true
        end
    end
    if player.Character then
        local charName = player.Character.Name:lower()
        if charName:find("killer") or charName:find("monster") then return true end
        if player.Character:FindFirstChild("Killer") or player.Character:GetAttribute("IsKiller") then return true end
    end
    return false
end

UserInputService.JumpRequest:Connect(function()
    if State.InfiniteJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- Главный цикл отрисовки и окружения
RunService.Stepped:Connect(function()
    if not LocalPlayer.Character then return end
    
    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum and State.WalkSpeed > 16 then
        hum.WalkSpeed = State.WalkSpeed
    end
    
    if State.Noclip then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
    
    if State.Fullbright then
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
        Lighting.FogEnd = 100000
    end
    
    -- Player ESP
    if State.PlayerESP then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                if not ESP_Storage.Players[player] or not ESP_Storage.Players[player].Parent then
                    local hl = Instance.new("Highlight")
                    hl.Name = "Velour_PlayerESP"
                    if IsKiller(player) then
                        hl.FillColor = Color3.fromRGB(255, 30, 30)
                    else
                        hl.FillColor = Color3.fromRGB(0, 150, 255)
                    end
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.4
                    hl.Parent = player.Character
                    ESP_Storage.Players[player] = hl
                end
            end
        end
    end
    
    -- Generator ESP
    if State.GeneratorESP then
        for _, obj in pairs(workspace:GetDescendants()) do
            if (obj.Name:lower():find("generator") or obj.Name:lower() == "gen") and obj:IsA("Model") then
                if not ESP_Storage.Generators[obj] or not ESP_Storage.Generators[obj].Parent then
                    local hl = Instance.new("Highlight")
                    hl.Name = "Velour_GenESP"
                    hl.FillColor = Color3.fromRGB(255, 215, 0)
                    hl.OutlineColor = Color3.fromRGB(0, 0, 0)
                    hl.FillTransparency = 0.3
                    hl.Parent = obj
                    ESP_Storage.Generators[obj] = hl
                end
            end
        end
    end
end)

