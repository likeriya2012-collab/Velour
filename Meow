-- 5. АВТОМАТИЗАЦИЯ ВЫЖИВШЕГО (Skill Check & Auto Repair)
---------------------------------------------------------------------

local function ProcessSurvivorLogic()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local myRoot = LocalPlayer.Character.HumanoidRootPart
    
    -- 1. Автоматическое прохождение Skill Check
    if State.AutoSkillCheck then
        pcall(function()
            for _, gui in pairs(LocalPlayer.PlayerGui:GetDescendants()) do
                if gui:IsA("TextLabel") or gui:IsA("ImageLabel") then
                    local name = gui.Name:lower()
                    if name:find("skillcheck") or name:find("target") or name:find("circle") or name:find("ring") then
                        -- Автоматический триггер клавиши пробела (если поддерживается эмуляция)
                        if vim then
                            vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                            task.wait(0.02)
                            vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                        end
                    end
                end
            end
        end)
    end
    
    -- 2. Автопочинка генераторов при приближении (включает взаимодействие без удержания)
    if State.AutoRepairGen then
        pcall(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj.Name:lower():find("generator") or obj.Name:lower() == "gen" then
                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then
                        local partToMeasure = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                        if partToMeasure and partToMeasure:IsA("BasePart") then
                            local dist = (myRoot.Position - partToMeasure.Position).Magnitude
                            if dist <= (prompt.MaxActivationDistance or 15) then
                                fireproximityprompt(prompt)
                            end
                        end
                    end
                end
            end
        end)
    end
end

---------------------------------------------------------------------
-- 6. БОЕВАЯ ЛОГИКА (ПАРИРОВАНИЕ И ФОНАРИК)
---------------------------------------------------------------------

local function ProcessCombatLogic()
    if not LocalPlayer.Character then return end
    local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local enemyRoot = player.Character:FindFirstChild("HumanoidRootPart")
            local enemyHum = player.Character:FindFirstChildOfClass("Humanoid")
            
            if enemyRoot and enemyHum then
                local dist = (myRoot.Position - enemyRoot.Position).Magnitude
                
                -- AUTO PARRY
                if State.AutoParry and dist <= 14 then
                    local animator = enemyHum:FindFirstChildOfClass("Animator")
                    if animator then
                        for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                            if track.IsPlaying and (track.Name:lower():find("attack") or track.Name:lower():find("swing") or track.Name:lower():find("slash")) then
                                if keypress then
                                    keypress(0x46) -- 'F'
                                    task.wait(0.05)
                                    keyrelease(0x46)
                                end
                                break
                            end
                        end
                    end
                end
                
                -- AUTO FLASHLIGHT
                if State.AutoFlashlight and IsKiller(player) and dist <= 25 then
                    local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if not tool or not tool.Name:lower():find("flashlight") then
                        local backpackTool = LocalPlayer.Backpack:FindFirstChild("Flashlight") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                        if backpackTool and backpackTool.Name:lower():find("flashlight") then
                            enemyHum:EquipTool(backpackTool)
                        end
                    end
                    
                    local enemyHead = player.Character:FindFirstChild("Head") or enemyRoot
                    if enemyHead then
                        myRoot.CFrame = CFrame.new(myRoot.Position, Vector3.new(enemyHead.Position.X, myRoot.Position.Y, enemyHead.Position.Z))
                        if tool and tool:IsA("Tool") then
                            tool:Activate()
                        end
                    end
                end

            end
        end
    end
end

-- Фоновые потоки выполнения циклов
task.spawn(function()
    while true do
        task.wait(0.03)
        pcall(ProcessCombatLogic)
    end
end)

task.spawn(function()
    while true do
        task.wait(0.1)
        pcall(ProcessSurvivorLogic)
    end
end)
