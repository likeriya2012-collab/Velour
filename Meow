local function AddToggle(parent, text, default, callback)
    local ToggleFrame = Instance.new("Frame")
    local ToggleCorner = Instance.new("UICorner")
    local Label = Instance.new("TextLabel")
    local Button = Instance.new("TextButton")
    local BtnCorner = Instance.new("UICorner")
    
    ToggleFrame.Parent = parent
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    ToggleFrame.Size = UDim2.new(1, -5, 0, 42)
    
    ToggleCorner.CornerRadius = UDim.new(0, 8)
    ToggleCorner.Parent = ToggleFrame
    
    Label.Parent = ToggleFrame
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 12, 0, 0)
    Label.Size = UDim2.new(0.7, 0, 1, 0)
    Label.Font = Enum.Font.GothamMedium
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(230, 230, 230)
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    Button.Parent = ToggleFrame
    Button.Position = UDim2.new(1, -52, 0.5, -11)
    Button.Size = UDim2.fromOffset(40, 22)
    Button.Font = Enum.Font.GothamBold
    Button.Text = ""
    
    BtnCorner.CornerRadius = UDim.new(1, 0)
    BtnCorner.Parent = Button
    
    local enabled = default
    local function update()
        Button.BackgroundColor3 = enabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(45, 45, 45)
        callback(enabled)
    end
    
    Button.MouseButton1Click:Connect(function()
        enabled = not enabled
        update()
    end)
    
    update()
end

local function AddSlider(parent, text, min, max, default, callback)
    local Frame = Instance.new("Frame")
    local Corner = Instance.new("UICorner")
    local Label = Instance.new("TextLabel")
    local ValLabel = Instance.new("TextLabel")
    local SliderBtn = Instance.new("TextButton")
    local SliderBar = Instance.new("Frame")
    
    Frame.Parent = parent
    Frame.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    Frame.Size = UDim2.new(1, -5, 0, 50)
    
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Frame
    
    Label.Parent = Frame
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 12, 0, 6)
    Label.Size = UDim2.new(0.6, 0, 0, 20)
    Label.Font = Enum.Font.GothamMedium
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(230, 230, 230)
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    
    ValLabel.Parent = Frame
    ValLabel.BackgroundTransparency = 1
    ValLabel.Position = UDim2.new(1, -60, 0, 6)
    ValLabel.Size = UDim2.new(0, 50, 0, 20)
    ValLabel.Font = Enum.Font.GothamBold
    ValLabel.Text = tostring(default)
    ValLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    ValLabel.TextSize = 12
    ValLabel.TextXAlignment = Enum.TextXAlignment.Right
    
    SliderBtn.Parent = Frame
    SliderBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    SliderBtn.Position = UDim2.new(0, 12, 0, 32)
    SliderBtn.Size = UDim2.new(1, -24, 0, 8)
    SliderBtn.Text = ""
    
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(1, 0)
    BtnCorner.Parent = SliderBtn
    
    SliderBar.Parent = SliderBtn
    SliderBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    SliderBar.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    
    local BarCorner = Instance.new("UICorner")
    BarCorner.CornerRadius = UDim.new(1, 0)
    BarCorner.Parent = SliderBar
    
    local dragging = false
    local function move(input)
        local pos = math.clamp((input.Position.X - SliderBtn.AbsolutePosition.X) / SliderBtn.AbsoluteSize.X, 0, 1)
        SliderBar.Size = UDim2.new(pos, 0, 1, 0)
        local val = math.floor(min + (max - min) * pos)
        ValLabel.Text = tostring(val)
        callback(val)
    end
    
    SliderBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            move(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            move(input)
        end
    end)
end

