-- Функция отправки клика паррирования (эмуляция нажатия F или клика)
local function TriggerParry()
    if vim then
        vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.01)
        vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    end
    -- Дополнительный вызов стандартных реплик взаимодействия, если они доступны
    pcall(function()
        local vu = game:GetService("VirtualUser")
        vu:Button1Down(Vector2.new(0,0))
        vu:Button1Up(Vector2.new(0,0))
    end)
end

-- Мануал спам по зажатию или нажатию клавиши (например, клик ПКМ или кнопка)
UserInputService.InputBegan:Connect(function(input, processed)
    if not processed then
        if input.KeyCode == State.ManualSpamKey or input.UserInputType == Enum.UserInputType.MouseButton2 then
            State.ManualSpamActive = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == State.ManualSpamKey or input.UserInputType == Enum.UserInputType.MouseButton2 then
        State.ManualSpamActive = false
    end
end)

-- Основной поток автоматики (Автопари, Автоспам, Абилки)
task.spawn(function()
    while true do
        task.wait(0.01)
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end

            -- Поиск мяча в Workspace
            local ball = nil
            for _, obj in pairs(Workspace:GetChildren()) do
                if obj.Name == "Ball" or obj:GetAttribute(" बॉल") or obj:FindFirstChild("Trail") or (obj:IsA("BasePart") and obj.AssemblyLinearVelocity.Magnitude > 10) then
                    ball = obj
                    break
                end
            end
            
            -- Ищем мяч точнее через папки арен если стандартно не нашлось
            if not ball and Workspace:FindFirstChild("Balls") then
                ball = Workspace.Balls:GetChildren()[1]
            end

            if ball and ball:IsA("BasePart") then
                local dist = (root.Position - ball.Position).Magnitude
                local speed = ball.AssemblyLinearVelocity.Magnitude
                
                -- Расчет динамической дистанции парирования на основе скорости мяча
                local calculatedDist = math.clamp(State.ParryDistance + (speed * 0.05), 10, 35)

                -- 1. Auto Parry
                if State.AutoParry and dist <= calculatedDist then
                    -- Проверяем, летит ли мяч на нас
                    local lookVector = root.CFrame.LookVector
                    local ballDir = (ball.Position - root.Position).Unit
                    local dot = lookVector:Dot(ballDir)
                    
                    if dot > -0.5 then -- Мяч приближается в поле видимости/на игрока
                        TriggerParry()
                    end
                end
                
                -- 2. Auto Spam / Manual Spam (Столкновения / Спам вблизи)
                if State.AutoSpam or State.ManualSpamActive then
                    if dist <= 22 then
                        TriggerParry()
                    end
                end
            end
        end)
    end
end)

